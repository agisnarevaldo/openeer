{
  "name": "openeer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @openeer/api dev",
    "dev:web": "bun --filter @openeer/web dev",
    "test": "bun test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "stop": "bun scripts/stop-dev.ts",
    "db:seed": "bun --filter @openeer/db db:seed",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.7.3"
  }
}
